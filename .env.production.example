APP_ENV=production
FRONTEND_PORT=8081
HSTS_HEADER=
PRODUCTION_BASE_URL=
UVICORN_WORKERS=2

POSTGRES_DB=buyma_ai
POSTGRES_USER=buyma_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://buyma_user:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@postgres:5432/buyma_ai

REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
CELERY_BROKER_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@redis:6379/1

SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini

CORS_ALLOWED_ORIGINS=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REGISTRATION_ENABLED=false
ENABLE_API_DOCS=false

EMBEDDING_JOB_STALE_MINUTES=10
EMBEDDING_RECOVERY_BATCH_SIZE=100

# Notification delivery remains disabled until a real channel adapter is configured.
NOTIFICATION_OUTBOX_CONSUMER_ENABLED=false
NOTIFICATION_DELIVERY_PROVIDER=disabled
SLACK_WEBHOOK_URL=
NOTIFICATION_SECRET_STORE=ssm
NOTIFICATION_OUTBOX_BATCH_SIZE=50
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_BASE_BACKOFF_SECONDS=60
NOTIFICATION_OUTBOX_MAX_BACKOFF_SECONDS=3600
NOTIFICATION_OUTBOX_LEASE_SECONDS=300
